import java.util.*;
import java.io.PrintStream;
import java.util.function.Function;
class AVLNode{
    AVLNode left,right;
    int data;
    int h;
    public AVLNode(int data){
        this.data=data;
        h=1;// new node will have 1 as height at begining even for all leaf nodes too
    }
}
class AVLTree{
    AVLNode root;
    public void inOrder(){
        inOrderHelper(root);// as our recursion needs root as parameter we used parameter
    }
    private void inOrderHelper(AVLNode root){
        if(root==null)
            return ;
        inOrderHelper(root.left);
        System.out.print(root.data+"-"+"ht:"+root.h+"   ");
        inOrderHelper(root.right);

    }
    public void insert(int a){
        // insert we took void because if we wanna update root we can do directly as they are in same class
        root=insertHelper(root,a);
    }     
    private AVLNode insertHelper(AVLNode root,int a){
        if(root==null){
            root=new AVLNode(a);
            return root;
        }
        if(a<root.data)
            root.left=insertHelper(root.left, a);
        else
            root.right=insertHelper(root.right, a);
        updateheight(root);
        //we dont need to check for 3 because at two only we are fixing so only check for 2 is enough
        if(getBF(root)==2)//left heavy
        {
            if(getBF(root.left)==1){//ll case
                root=rightrotate(root);
            }
            else{ // lr case
                
            }
        }
        else if(getBF(root)==-2){//right heavy
            if(getBF(root.right)==-1){//rr case
                root=leftrotate(root);
            }
            else{ // rl case
                
            }
            
        }
        return root;
    }
    public AVLNode leftrotate(AVLNode root){
        AVLNode nn=root.right;//2 - new root
        AVLNode t1=root.left;
        AVLNode t2=nn.left;
        root.right=t2; //1-> right became t2
        updateheight(root);//as now it wont be root it height will be updated
        nn.left=root;
        updateheight(nn);
        return nn;
    }
    public AVLNode rightrotate(AVLNode root){
        AVLNode nn=root.left;
        root.left=nn.right;
        updateheight(root);
        nn.right=root;
        updateheight(nn);
        return nn;
    }
    public int getBF(AVLNode root){
        return (root.left==null?0:root.left.h)-(root.right==null?0:root.right.h);
    }
    public void updateheight(AVLNode root){
        if(root==null) return;
        root.h=1+Math.max(root.left==null?0:root.left.h,root.right==null?0:root.right.h);
    }
    public int height(){
        return helperHeight(root);
    }
    private int helperHeight(AVLNode root){
        if(root==null)
            return 0;
        return 1+Math.max(helperHeight(root.left),helperHeight(root.right));
    }
    public int size(){
        return hsize(root);
    }
    private int hsize(AVLNode root){
        if(root==null)
            return 0;// 0 or -1 according to the question
        return 1+hsize(root.left)+hsize(root.right);
    }
    public void printTreeLikeATree(){
        TreePrinter <AVLNode> printer=new TreePrinter<>(n-> ""+n.data,n->n.left,n->n.right);
        printer.printTree(root);
    }
}
